<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RecuperarPassword">
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:contentDescription="Imagen de Login"
        app:srcCompat="@drawable/loginlogo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.2"
        />
    <TextView
        android:id="@+id/lblTitulo"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:text="RECUPERAR CONTRASEÑA"
        android:layout_margin="10dp"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@+id/imgLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.24"
        />
    <TextView
        android:id="@+id/lblCorreoRe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Correo de recuperación:"
        android:textSize="20sp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/lblTitulo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
    <EditText
        android:id="@+id/txtCorreoRe"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/lblCorreoRe"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <Button
        android:id="@+id/btnRecuperarCon"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:text="Recuperar contraseña"
        android:textStyle="bold"
        android:textSize="16dp"
        android:layout_margin="60dp"
        android:textColor="@color/white"
        android:backgroundTint="#0091FF"
        app:layout_constraintTop_toBottomOf="@+id/txtCorreoRe"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
    <TextView
        android:id="@+id/lblRegresar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Regesar al inicio"
        android:textSize="12sp"
        android:layout_marginTop="100dp"
        android:textColor="#000080"
        app:layout_constraintTop_toBottomOf="@+id/btnRecuperarCon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_bias="0.88"
        />

</androidx.constraintlayout.widget.ConstraintLayout>